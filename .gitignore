# Python: служебные файлы, создаются автоматически
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Данные: большие файлы, версионируем через DVC, а не git
data/raw/*
!data/raw/.gitkeep
!data/raw/*.dvc
data/processed/*
!data/processed/.gitkeep

# Модели: в git только итоговая модель (150 КБ), нужна для Docker
models/*
!models/.gitkeep
!models/model.pkl

# MLflow: локальная база экспериментов
mlruns/
mlflow.db
mlartifacts/

# Секреты
.env
